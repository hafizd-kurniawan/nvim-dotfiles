# Ubuntu-compatible BSPWM configuration
# =============================================================

# Set environment variables
export PATH="$HOME/.config/bspwm/src:$PATH"
export XDG_CURRENT_DESKTOP='bspwm'
## Fix java applications
export _JAVA_AWT_WM_NONREPARENTING=1

#  ╦ ╦╔═╗╦═╗╦╔═╔═╗╔═╗╔═╗╔═╗╔═╗╔═╗
#  ║║║║ ║╠╦╝╠╩╗╚═╗╠═╝╠═╣║  ║╣ ╚═╗
#  ╚╩╝╚═╝╩╚═╩ ╩╚═╝╩  ╩ ╩╚═╝╚═╝╚═╝

# Monitor setup - Ubuntu compatible
"$HOME"/.config/bspwm/src/MonitorSetup || {
    # Fallback if MonitorSetup script doesn't exist
    bspc monitor -d I II III IV V VI VII VIII IX X
}

#  ╔╗ ╔═╗╔═╗╦ ╦╔╦╗  ╔═╗╔═╗╔╗╔╔═╗╦╔═╗
#  ╠╩╗╚═╗╠═╝║║║║║║  ║  ║ ║║║║╠╣ ║║ ╦
#  ╚═╝╚═╝╩  ╚╩╝╩ ╩  ╚═╝╚═╝╝╚╝╚  ╩╚═╝

# External rules if available
[ -f "${HOME}/.config/bspwm/src/ExternalRules" ] && \
    bspc config external_rules_command "${HOME}/.config/bspwm/src/ExternalRules"

bspc config window_gap                8
bspc config split_ratio               0.52
bspc config single_monocle            true
bspc config borderless_monocle        true
bspc config gapless_monocle           true

bspc config automatic_scheme          longest_side
bspc config initial_polarity          second_child
bspc config removal_adjustment        true

bspc config focus_follows_pointer     true
bspc config pointer_follows_focus     false
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

# Border and colors
bspc config border_width              2
bspc config normal_border_color       "#414868"
bspc config active_border_color       "#c0caf5"
bspc config focused_border_color      "#bb9af7"
bspc config presel_feedback_color     "#7aa2f7"

#  ╔═╗╦ ╦╔╦╗╔═╗╔═╗╔╦╗╔═╗╦═╗╔╦╗
#  ╠═╣║ ║ ║ ║ ║╚═╗ ║ ╠═╣╠╦╝ ║
#  ╩ ╩╚═╝ ╩ ╚═╝╚═╝ ╩ ╩ ╩╩╚═ ╩

run() {
  if ! pgrep -x "$1" >/dev/null; then
    "$@" &
  fi
}

# Kill existing processes
pkill -x sxhkd
pkill -x picom
pkill -x polybar
pkill -x dunst

# Set system variables for polybar
[ -f "$HOME/.config/bspwm/src/SetSysVars" ] && "$HOME/.config/bspwm/src/SetSysVars"

# Launch sxhkd daemon
if [ -f "${HOME}/.config/bspwm/src/config/sxhkdrc" ]; then
    run sxhkd -c "${HOME}/.config/bspwm/src/config/sxhkdrc"
else
    run sxhkd -c "${HOME}/.config/sxhkd/sxhkdrc"
fi

# Load current theme
[ -f "${HOME}/.config/bspwm/src/Theme.sh" ] && "${HOME}/.config/bspwm/src/Theme.sh"

# Launch compositor
if command -v picom >/dev/null; then
    if [ -f "${HOME}/.config/bspwm/src/config/picom.conf" ]; then
        run picom --config "${HOME}/.config/bspwm/src/config/picom.conf"
    else
        run picom --config "${HOME}/.config/picom/picom.conf"
    fi
fi

# Launch xsettingsd
if command -v xsettingsd >/dev/null; then
    if [ -f "${HOME}/.config/bspwm/src/config/xsettingsd" ]; then
        run xsettingsd --config="${HOME}/.config/bspwm/src/config/xsettingsd"
    fi
fi

# Launch polybar
if command -v polybar >/dev/null; then
    run polybar main -c "${HOME}/.config/polybar/config.ini"
fi

# Launch notification daemon
if command -v dunst >/dev/null; then
    run dunst -config "${HOME}/.config/dunst/dunstrc"
fi

# Launch clipboard manager
if command -v clipcatd >/dev/null; then
    run clipcatd
elif command -v greenclip >/dev/null; then
    run greenclip daemon
fi

# Launch authentication agent
if command -v lxpolkit >/dev/null; then
    run lxpolkit
elif command -v /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null; then
    run /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
fi

# Set wallpaper
if command -v feh >/dev/null; then
    [ -f "$HOME/.config/bspwm/wallpapers/default.jpg" ] && \
        feh --bg-fill "$HOME/.config/bspwm/wallpapers/default.jpg"
elif command -v nitrogen >/dev/null; then
    run nitrogen --restore
fi

# Application rules
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a firefox desktop='^2'
bspc rule -a discord desktop='^5'
bspc rule -a Spotify desktop='^5'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a Zathura state=tiled